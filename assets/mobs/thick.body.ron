// A thick woman, for testing soft tissue (`soft-tissue` feature) at its extreme: very wide hips
// and thighs that meet, a full belly, heavy breasts and buttocks on strong muscle (fat 1.3, muscle
// 0.9). Silhouette after the references in research_notes/ (female base meshes). Built like the
// curvy plan: the biped's proportions (stature 1.6 m), torso standing (t = 0 pelvis, 1 shoulders;
// around 0 = back, 90 = left, 180 = front).
//
// Stamp heights stay under about half their footprint (fat tone scales height by 1.5·fat and the
// footprint by 1 + fat/2, so depth ≤ ~0.47·size at this tone): steeper bulges break the mesh.
// Overlapping stamps add their heights, so neighbours (hip and outer thigh) stay well under it.
// Breasts and buttocks are teardrops (`form: Drop`) and the belly a mass (`form: Mass`): real
// bodies of fat that hang and fold under themselves, which a raised stamp can't. `soft:` tunes how
// each moves: firmness (below 1 softer and slower), damping (below 1 wobbles longer), travel.
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → chest → shoulders: hips flaring wide from a narrow waist, a broad
            // ribcage. The pelvis end narrows so its cap tucks between the thighs.
            chain: (segments: 3, length: 0.46, radius: (curve: [(0.0, 0.85), (0.12, 1.45), (0.26, 1.12), (0.44, 0.62), (0.56, 0.72), (0.72, 0.98), (1.0, 0.72)], scale: 0.13, cross: Ellipse(aspect: 1.7))),
            belly: 0.22,
        )),
        offset: (rotate_deg: (-90.0, 0.0, 0.0)),
        detail: Always,
        // Upright torso stamps (`tone::upright_torso_stamps`) with softer muscle, plus breasts and
        // the fat of the hips and buttocks. Around 0 = back, 90 = left, 180 = front.
        stamps: Custom([
            (at: Surface(t: 0.6, around_deg: 146.0), kind: Fat, size: (0.58, 0.72, 0.47), depth: 0.06, mirror: true, form: Drop, hang: 0.25, soft: (firmness: 0.8, damping: 0.7)), // breast: a hanging teardrop, soft
            (at: Surface(t: 0.82, around_deg: 150.0), kind: Muscle, size: (0.65, 0.42, 0.35), depth: 0.06, mirror: true), // pectoral above it
            (at: Surface(t: 0.93, around_deg: 100.0), kind: Muscle, size: (0.34, 0.32, 0.3), depth: 0.06, mirror: true),  // top of the shoulder
            (at: Surface(t: 0.55, around_deg: 15.0), kind: Muscle, size: (0.18, 1.5, 0.22), depth: 0.05, mirror: true),   // ridges beside the spine
            (at: Surface(t: 0.8, around_deg: 35.0), kind: Landmark, size: (0.28, 0.4, 0.15), depth: 0.02, mirror: true),  // shoulder blade
            (at: Surface(t: 0.1, around_deg: 40.0), kind: Fat, size: (0.56, 0.8, 0.52), depth: -0.08, mirror: true, form: Drop, hang: 0.25, soft: (firmness: 0.9)), // buttock: a broad teardrop sunk in the body, full at the fold
            (at: Surface(t: 0.1, around_deg: 0.0), kind: Hollow, size: (0.07, 0.75, 0.3), depth: 1.2, mirror: false),   // the cleft between the cheeks
            (at: Surface(t: 0.14, around_deg: 30.0), kind: Muscle, size: (0.55, 0.5, 0.42), depth: 0.07, mirror: true), // glute under it
            (at: Surface(t: 0.13, around_deg: 85.0), kind: Fat, size: (0.62, 0.8, 0.5), depth: 0.2, mirror: true),     // hip flare
            (at: Surface(t: 0.3, around_deg: 180.0), kind: Fat, size: (0.62, 0.42, 0.36), depth: 0.08, mirror: false, form: Mass, hang: 0.3, soft: (firmness: 0.75, damping: 0.8)), // belly, hanging a little
            (at: Surface(t: 0.32, around_deg: 105.0), kind: Fat, size: (0.36, 0.4, 0.34), depth: 0.03, mirror: true),  // love handle, slight
        ]),
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.17, radius: (curve: [(0.0, 1.15), (0.4, 0.9), (1.0, 0.85)], scale: 0.045)))),
                attach: End,
                detail: Always,
                children: [
                    (
                        name: "head",
                        // Head ≈ 1/7.5 of stature: ~0.21 tall, 0.15 wide, 0.19 deep.
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.075, 0.1, 0.09)),
                            snout: 0.0,
                            jaw: Some((segments: 1, length: 0.08)),
                            eye_spacing: 0.42,
                            // A modest nose: the default (1.0) reads as a beak in profile at this size.
                            face: Some((nose: 0.7)),
                        )),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.012, sclera: 1.0)), attach: Eye, mirror: true),
                            // Ears: rigid flaps flat on the sides of the head, ~6 cm tall.
                            (name: "ear", kind: Mass((shape: Flap, size: (0.016, 0.027, 0.03), blend: 0.004)), attach: Ear, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                // Thigh ≈ shank (0.245 / 0.246 of stature); hip joints ~0.1 of stature apart, inside
                // the hip's outer width. Knees softly bent at rest.
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.8, ratios: [1.0, 1.0], radius: (curve: [(0.0, 1.25), (0.2, 1.1), (0.44, 0.7), (0.56, 0.66), (0.72, 0.64), (1.0, 0.38)], scale: 0.1)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.22),
                    joints: Some((plan: Leg, swing: 14.0, flex: [28.0])),
                )),
                // Strong muscle under heavy fat; the thigh's fat on its outer curve and inside, where
                // thighs meet (the default's sits behind the thigh and hangs below the buttock).
                stamps: Custom([
                    (at: Surface(t: 0.22, around_deg: 180.0), kind: Muscle, size: (0.62, 1.8, 0.32), depth: 0.07),  // front of thigh
                    (at: Surface(t: 0.22, around_deg: 0.0), kind: Muscle, size: (0.6, 1.8, 0.3), depth: 0.06),      // back of thigh
                    (at: Surface(t: 0.16, around_deg: 260.0), kind: Fat, size: (0.6, 0.9, 0.45), depth: 0.16),     // outer thigh
                    (at: Surface(t: 0.16, around_deg: 100.0), kind: Fat, size: (0.5, 0.9, 0.42), depth: 0.13),    // inner thigh
                    (at: Surface(t: 0.66, around_deg: 0.0), kind: Muscle, size: (0.55, 1.3, 0.34), depth: 0.09),   // calf
                    (at: Surface(t: 0.5, around_deg: 270.0), kind: Landmark, size: (0.3, 0.4, 0.2), depth: 0.015), // outer knee
                ]),
                attach: Surface(t: 0.05, around_deg: 112.0),
                offset: (translate: (0.0, -0.04, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                // Upper arm 0.186, forearm 0.146 of stature; hands reach mid-thigh.
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.535, ratios: [1.0, 0.78], radius: (curve: [(0.0, 1.15), (0.45, 0.8), (1.0, 0.5)], scale: 0.05)),
                    role: Manipulator,
                    end: Hand(palm: 0.09),
                    joints: Some((plan: Arm, swing: 0.0, flex: [15.0])),
                    splay_deg: 6.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                offset: (translate: (0.0, 0.035, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        // Three phalanges, shortening toward the tip (~0.45 / 0.3 / 0.25 of the finger).
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.085, ratios: [1.0, 0.66, 0.55], radius: (curve: [(0.0, 1.0), (1.0, 0.8)], scale: 0.0085), curl: 160.0), spread_deg: 16.0, opposable: true)),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.9, fat: 1.3),
)
