// An ox (castrated draught bull, Bos taurus) on beef-breed proportions, withers ~1.45 m (see
// docs/design/anatomy-reference.md). Longer than tall (body length ≈ 1.2 × withers), with a deep,
// wide barrel (chest depth ≈ 0.55 × withers, heart girth ≈ 1.35 × withers), a level topline, a
// broad croup and heavy quarters. Short neck carried low, the head long and broad-browed with a
// wide, moist muzzle, horns from the poll, a dewlap from throat to brisket. The legs are short
// and stout under the body, each on a cloven hoof; the tail hangs to the hocks and ends in a
// switch.
(
    root: (
        name: "torso",
        kind: Torso((
            // Croup → loin → barrel → chest: wider and deeper than a horse's, level on top.
            chain: (segments: 4, length: 1.45, radius: (
                curve: [(0.0, 0.92), (0.3, 0.95), (0.6, 1.05), (0.85, 1.0), (1.0, 0.85)], scale: 0.34, cross: Ellipse(aspect: 0.92),
                width: [(0.0, 1.15), (0.2, 1.05), (0.55, 1.2), (0.85, 0.95), (1.0, 0.85)],
                depth: [(0.0, 1.05), (0.2, 1.0), (0.5, 1.18), (0.75, 1.25), (0.9, 1.28), (1.0, 1.15)],
                drop: [(0.0, 0.05), (0.2, 0.0), (0.5, 0.19), (0.75, 0.27), (0.9, 0.3), (1.0, 0.16)],
            )),
            arch: [(0.0, 0.0), (0.4, -0.02), (0.75, 0.0), (1.0, 0.03)],
            belly: 0.45,
        )),
        detail: Always,
        stamps: Custom([
            (at: Surface(t: 0.93, around_deg: 0.0), kind: Muscle, size: (0.9, 0.35, 0.4), depth: 0.08), // withers / shoulder hump
            (at: Surface(t: 0.86, around_deg: 70.0), kind: Muscle, size: (0.6, 0.55, 0.4), depth: 0.06, mirror: true), // shoulder
            (at: Surface(t: 0.1, around_deg: 60.0), kind: Muscle, size: (0.7, 0.6, 0.45), depth: 0.07, mirror: true), // rump
            (at: Surface(t: 0.02, around_deg: 30.0), kind: Landmark, size: (0.25, 0.25, 0.2), depth: 0.05, mirror: true), // pin bones
            (at: Surface(t: 0.22, around_deg: 50.0), kind: Landmark, size: (0.3, 0.3, 0.2), depth: 0.05, mirror: true), // hook bones
            (at: Surface(t: 0.55, around_deg: 95.0), kind: Landmark, size: (0.5, 0.9, 0.12), depth: 0.015, mirror: true), // ribs
        ]),
        children: [
            (
                // Short and deep, carried low, sloping down from the withers.
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 3, length: 0.55, radius: (curve: [(0.0, 1.0), (0.5, 0.75), (1.0, 0.62)], scale: 0.26, cross: Ellipse(aspect: 0.62)), curl: -10.0))),
                attach: End,
                offset: (rotate_deg: (-34.0, 0.0, 0.0), translate: (0.0, 0.0, 0.05)),
                detail: Always,
                children: [
                    (
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.155, 0.14, 0.16)),
                            snout: 0.33,
                            jaw: Some((segments: 1, length: 0.36)),
                            eye_spacing: 0.92,
                            eye_lateral: 0.9,
                            pitch: 55.0,
                            // Broad and straight: a flat forehead running down to a wide, square
                            // muzzle with big nostrils and a deep lower jaw.
                            muzzle: (base: (0.9, 0.78), tip: (0.78, 0.55), rise: 0.15, drop: 6.0, cheek: 0.8, nostrils: 1.3, lips: 0.9, jaw_depth: 1.5, jaw_width: 1.3),
                        )),
                        offset: (rotate_deg: (25.0, 0.0, 0.0), translate: (0.0, 0.0, 0.05)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.024)), attach: Eye, mirror: true),
                            // Ears: horizontal, below and behind the horns.
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 2, length: 0.17, radius: (curve: [(0.0, 0.5), (0.45, 1.0), (1.0, 0.35)], scale: 0.045, cross: Flat(aspect: 2.4)), blend: 0.01))), attach: Ear, offset: (rotate_deg: (0.0, 0.0, -55.0)), mirror: true),
                            // Horns: out from the poll, curving forward and up.
                            (name: "horn", kind: Hard((kind: Horn, size: 0.34, curve: 0.55, twist: 0.1)), attach: Horn, offset: (rotate_deg: (-35.0, 0.0, -50.0)), mirror: true),
                            // Curly poll hair.
                            (name: "poll", kind: Mass((shape: Hump, size: (0.09, 0.03, 0.06), blend: 0.03)), attach: Crown),
                        ],
                    ),
                    // Dewlap: a loose fold of skin hanging under the throat and neck.
                    (name: "dewlap", kind: Mass((shape: Flap, size: (0.22, 0.14, 0.3), blend: 0.1)), attach: Surface(t: 0.35, around_deg: 180.0), offset: (rotate_deg: (0.0, 90.0, 0.0))),
                ],
            ),
            // The dewlap continues to the brisket.
            (name: "brisket", kind: Mass((shape: Flap, size: (0.24, 0.12, 0.35), blend: 0.12)), attach: Surface(t: 0.98, around_deg: 180.0), offset: (rotate_deg: (0.0, 90.0, 0.0))),
            (
                name: "limb.front",
                kind: Limb((
                    chain: (segments: 4, length: 0.95, ratios: [0.85, 0.9, 0.55, 0.25], radius: (curve: [(0.0, 1.2), (0.3, 0.9), (0.5, 0.52), (0.85, 0.46), (1.0, 0.5)], scale: 0.125)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: true),
                    joints: Some((plan: Foreleg, swing: -28.0, flex: [30.0, 0.0, -30.0])),
                )),
                attach: Surface(t: 0.86, around_deg: 135.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "limb.hind",
                kind: Limb((
                    chain: (segments: 4, length: 1.15, ratios: [1.0, 1.0, 0.7, 0.25], radius: (curve: [(0.0, 1.5), (0.3, 1.0), (0.55, 0.52), (0.85, 0.44), (1.0, 0.5)], scale: 0.125)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: true),
                    joints: Some((plan: Hindleg, swing: 22.0, flex: [42.0, 34.0, -26.0])),
                )),
                attach: Surface(t: 0.1, around_deg: 130.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Hangs to the hocks; the switch is a tuft of long hair at its end.
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 4, length: 0.85, radius: (curve: [(0.0, 1.0), (0.2, 0.55), (0.75, 0.45), (1.0, 0.4)], scale: 0.05), curl: 60.0))),
                attach: Start,
                offset: (rotate_deg: (35.0, 0.0, 0.0), translate: (0.0, 0.0, -0.12)),
                children: [
                    (name: "switch", kind: Mass((shape: Ellipsoid, size: (0.05, 0.13, 0.05), blend: 0.03)), attach: End),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.7, fat: 0.35, landmarks: 0.5),
)
