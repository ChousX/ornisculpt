                attach: Start,
                detail: Always,
            ),
            (
                // Hindwings first, so the elytra sit over them.
                name: "hindwing",
                kind: Wing((kind: Blade((planform: Long)), span: 0.29, chord: 0.12, fold: 1.0, sweep_deg: 10.0)),
                attach: Surface(t: 0.1, around_deg: 35.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "elytron",
                kind: Wing((kind: Blade((planform: Round, elytron: true)), span: 0.31, chord: 0.11, fold: 1.0, sweep_deg: 0.0)),
                attach: Surface(t: 0.15, around_deg: 25.0),
                offset: (translate: (0.0, 0.012, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
