// A beetle: the hexapod body with hardened, domed forewings (elytra) closed over the abdomen
// and veined membranous hindwings folded beneath them. See docs/design/wings.md.
(
    root: (
        name: "thorax",
        kind: Torso((
            chain: (segments: 3, length: 0.17, radius: (curve: [(0.0, 0.9), (0.6, 1.0), (1.0, 0.8)], scale: 0.065, cross: Ellipse(aspect: 1.4))),
        )),
        detail: Always,
        children: [
            (
                name: "head",
                kind: Head((skull: (shape: Ellipsoid, size: (0.05, 0.035, 0.045)), snout: 0.01, jaw: None, eye_spacing: 0.9, eye_lateral: 0.9)),
                attach: End,
                offset: (rotate_deg: (20.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (name: "eye", kind: Hard((kind: Eye, size: 0.016)), attach: Eye, mirror: true),
                    (name: "antenna", kind: Chain((role: Antenna, chain: (segments: 3, length: 0.15, radius: (curve: [(0.0, 1.0), (1.0, 0.6)], scale: 0.006), curl: 60.0, blend: 0.004))), attach: Horn, mirror: true),
                ],
            ),
            (
