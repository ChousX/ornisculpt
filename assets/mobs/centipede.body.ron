// A giant centipede (Scolopendra) at mob scale: body ~0.8 m, flat and wider than tall, in a
// run of jointed segments. One pair of legs to a segment, sixteen pairs here, each short, arched,
// knee up and tip on the ground, growing no longer toward the rear. A small flat head with long
// antennae and a pair of forcipules (the venom claws) curled under it; the last segment trails a
// pair of long sensory legs. Sixteen pairs of legs is thirty-two limbs meshed apart: more than
// the twelve the field once kept apart at a point, and (as `share_regions`) too many for each to
// take regions of its own.
(
    root: (
        name: "trunk",
        kind: Torso((
            // Rear → front: a long flat run of rings, a little deeper through the middle.
            chain: (segments: 12, length: 0.8, segmented: 0.55, radius: (curve: [(0.0, 0.72), (0.08, 0.92), (0.5, 1.0), (0.92, 0.92), (1.0, 0.78)], scale: 0.038, cross: Ellipse(aspect: 1.5))),
        )),
        detail: Always,
        children: [
            (
                // Flat head plate, a little narrower than the first segment, no snout to speak of.
                name: "head",
                kind: Head((skull: (shape: Ellipsoid, size: (0.034, 0.016, 0.03)), snout: 0.0, jaw: None, eye_spacing: 0.85, eye_lateral: 0.95)),
                attach: End,
                offset: (translate: (0.0, 0.0, 0.004), rotate_deg: (-8.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    // Ocelli: small, on the sides.
                    (name: "eye", kind: Hard((kind: Eye, size: 0.005)), attach: Eye, mirror: true),
                    // Antennae: long, jointed, swept forward and out.
                    (name: "antenna", kind: Chain((role: Antenna, chain: (segments: 4, length: 0.22, ratios: [0.7, 0.9, 1.1, 1.3], segmented: 0.5, radius: (curve: [(0.0, 1.0), (1.0, 0.3)], scale: 0.0045), curl: 10.0, blend: 0.003))), attach: Horn, offset: (rotate_deg: (60.0, 25.0, 0.0)), mirror: true),
                    // Forcipules: the venom claws, curled under and forward of the head.
                    (name: "forcipule", kind: Chain((role: Tentacle, chain: (segments: 2, length: 0.05, ratios: [1.0, 0.7], segmented: 0.5, radius: (curve: [(0.0, 1.0), (1.0, 0.35)], scale: 0.006), curl: -50.0, blend: 0.003))), attach: Mouth, offset: (translate: (0.012, 0.0, 0.0), rotate_deg: (50.0, 0.0, 25.0)), mirror: true),
                ],
            ),
            (
                // Walking legs: one pair a segment, all alike, knees up, tips on the ground. All
                // the pairs on a side share one set of regions (upper, lower, end), so a coat
                // colours the legs together and the body stays inside the region budget.
                name: "leg",
                kind: Limb((chain: (segments: 3, length: 0.15, ratios: [0.8, 1.0, 1.0], segmented: 0.75, radius: (curve: [(0.0, 1.0), (1.0, 0.4)], scale: 0.0075)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 40.0, flex: [95.0, 30.0])))),
                attach: Surface(t: 0.12, around_deg: 105.0),
                repeat: Series(count: 16, from: 0.07, to: 0.93),
                share_regions: true,
                mirror: true,
                detail: Always,
            ),
            (
                // The last pair: long, thin, trailing behind as feelers.
                name: "terminal",
                kind: Chain((role: Antenna, chain: (segments: 3, length: 0.17, ratios: [0.8, 1.0, 1.2], segmented: 0.6, radius: (curve: [(0.0, 1.0), (1.0, 0.3)], scale: 0.005), curl: 0.0, blend: 0.003))),
                attach: Surface(t: 0.01, around_deg: 100.0),
                offset: (rotate_deg: (-150.0, 0.0, -20.0)),
                mirror: true,
                detail: Always,
            ),
        ],
    ),
    tone: (muscle: 0.0, fat: 0.0, folds: 0.0, landmarks: 0.0),
)
