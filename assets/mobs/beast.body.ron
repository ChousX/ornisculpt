// A heavy plantigrade quadruped on bear proportions (shoulder ~0.9 m; see
// docs/design/anatomy-reference.md), built with authored parts: sculpted feet (blended SDF) and
// a rigid crest mesh from assets/parts/sample_parts.gltf (tools/gen_sample_parts.py).
// Body ≈ 1.6× shoulder height, short columnar legs on whole feet, a shoulder hump, a broad head.
(
    root: (
        name: "torso",
        kind: Torso((
            chain: (segments: 4, length: 1.15, radius: (curve: [(0.0, 0.85), (0.35, 0.92), (0.7, 1.0), (1.0, 0.9)], scale: 0.24, cross: Ellipse(aspect: 0.9))),
            arch: [(0.0, 0.0), (0.5, 0.03), (1.0, 0.0)],
            belly: 0.45,
        )),
        detail: Always,
        children: [
            (
                // Shoulder hump: the muscle mass over the withers that powers digging.
                name: "hump",
                kind: Mass((shape: Hump, size: (0.17, 0.07, 0.24), blend: 0.1)),
                attach: Surface(t: 0.8, around_deg: 0.0),
                offset: (translate: (0.0, -0.05, 0.0)),
                detail: Always,
            ),
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.16, radius: (curve: [(0.0, 1.0), (1.0, 0.85)], scale: 0.17)))),
                attach: End,
                offset: (rotate_deg: (-12.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.16, 0.135, 0.15)),
                            snout: 0.15,
                            jaw: Some((segments: 1, length: 0.17)),
                            eye_spacing: 0.5,
                            eye_lateral: 0.2,
                        )),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.018)), attach: Eye, mirror: true),
                            (name: "crest", kind: Hard((kind: Mesh(path: "parts/sample_parts.gltf#Mesh1/Primitive0", scale: 1.6))), attach: Crown),
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 1, length: 0.06, radius: (curve: [(0.0, 0.8), (0.5, 1.0), (1.0, 0.6)], scale: 0.035, cross: Flat(aspect: 2.0)), blend: 0.015))), attach: Ear, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                // Columnar: humerus ≈ forearm, elbow only slightly back.
                name: "limb.front",
                kind: Limb((
                    chain: (segments: 2, length: 0.56, ratios: [1.0, 0.95], radius: (curve: [(0.0, 1.0), (0.5, 0.75), (1.0, 0.62)], scale: 0.1)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: None,
                    bends: [(-12.0, 0.0), (14.0, 0.0)],
                )),
                attach: Surface(t: 0.86, around_deg: 140.0),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "foot",
                        kind: Sculpt((mesh: "parts/sample_parts.gltf#Mesh0/Primitive0", scale: 1.9, blend: 0.04)),
                        attach: End,
                        detail: Always,
                    ),
                ],
            ),
            (
                // Femur near vertical, shorter tibia, whole foot down.
                name: "limb.hind",
                kind: Limb((
                    chain: (segments: 2, length: 0.56, ratios: [1.0, 0.82], radius: (curve: [(0.0, 1.3), (0.45, 0.85), (1.0, 0.6)], scale: 0.1)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: None,
                    bends: [(14.0, 0.0), (-24.0, 0.0)],
                )),
                attach: Surface(t: 0.1, around_deg: 130.0),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "foot",
                        kind: Sculpt((mesh: "parts/sample_parts.gltf#Mesh0/Primitive0", scale: 2.1, blend: 0.04)),
                        attach: End,
                        detail: Always,
                    ),
                ],
            ),
            (
                // A stub.
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 2, length: 0.1, radius: (curve: [(0.0, 1.0), (1.0, 0.5)], scale: 0.04)))),
                attach: Start,
                offset: (rotate_deg: (30.0, 0.0, 0.0)),
            ),
        ],
    ),
    tone: (muscle: 0.5, fat: 0.6, fold_noise: (kind: OpenSimplex2, fractal: Ridged, frequency: 25.0, amplitude: 0.003)),
)
