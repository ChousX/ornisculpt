// An upright two-legged creature with grasping hands, on human proportions (stature 1.6 m;
// see docs/design/anatomy-reference.md). The torso is rotated to stand vertically: its Start
// (t = 0) is the pelvis, its End the shoulders; around 0 = back, 90 = left, 180 = belly.
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → chest → shoulders; ~1.5× wider than deep.
            chain: (segments: 3, length: 0.47, radius: (curve: [(0.0, 0.95), (0.35, 0.8), (0.75, 1.0), (1.0, 0.72)], scale: 0.125, cross: Ellipse(aspect: 1.5))),
            belly: 0.15,
        )),
        offset: (rotate_deg: (-90.0, 0.0, 0.0)),
        detail: Always,
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.17, radius: (curve: [(0.0, 1.15), (0.4, 0.9), (1.0, 0.85)], scale: 0.045)))),
                attach: End,
                detail: Always,
                children: [
                    (
                        name: "head",
                        // Head ≈ 1/7.5 of stature: ~0.21 tall, 0.15 wide, 0.19 deep.
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.075, 0.1, 0.09)),
                            snout: 0.04,
                            jaw: Some((segments: 1, length: 0.08)),
                            eye_spacing: 0.42,
                        )),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.016)), attach: Eye, mirror: true),
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 2, length: 0.06, radius: (curve: [(0.0, 0.6), (0.5, 1.0), (1.0, 0.3)], scale: 0.026, cross: Flat(aspect: 3.0)), blend: 0.01))), attach: Ear, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                // Thigh ≈ shank (0.245 / 0.246 of stature); hip joints ~0.1 of stature apart, inside
                // the hip's outer width. Knees softly bent at rest.
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.8, ratios: [1.0, 1.0], radius: (curve: [(0.0, 1.0), (0.45, 0.62), (0.58, 0.68), (1.0, 0.42)], scale: 0.075)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.22),
                    bends: [(14.0, 0.0), (-28.0, 0.0)],
                )),
                attach: Surface(t: 0.04, around_deg: 120.0),
                offset: (translate: (0.0, -0.02, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                // Upper arm 0.186, forearm 0.146 of stature; hands reach mid-thigh.
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.535, ratios: [1.0, 0.78], radius: (curve: [(0.0, 1.0), (0.5, 0.72), (1.0, 0.55)], scale: 0.045)),
                    role: Manipulator,
                    end: Hand(palm: 0.09),
                    splay_deg: 6.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                offset: (translate: (0.0, 0.035, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        // Three phalanges, shortening toward the tip (~0.45 / 0.3 / 0.25 of the finger).
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.085, ratios: [1.0, 0.66, 0.55], radius: (curve: [(0.0, 1.0), (1.0, 0.8)], scale: 0.0085), curl: 160.0), spread_deg: 16.0, opposable: true)),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.6, fat: 0.2),
)
