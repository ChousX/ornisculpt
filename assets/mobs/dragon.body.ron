// A six-limbed dragon: four legs plus bat-style membrane wings (three long fingers fanning a
// scalloped membrane back to the hind legs, a clawed thumb at the wrist). Horse-sized body on
// carnivore legs, long neck and tail. See docs/design/wings.md.
(
    root: (
        name: "torso",
        kind: Torso((
            chain: (segments: 4, length: 1.6, radius: (curve: [(0.0, 0.8), (0.3, 0.74), (0.6, 0.95), (0.85, 1.0), (1.0, 0.85)], scale: 0.32, cross: Ellipse(aspect: 0.85))),
            arch: [(0.0, 0.0), (0.6, 0.04), (1.0, 0.0)],
            belly: 0.3,
        )),
        detail: Always,
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 4, length: 1.1, radius: (curve: [(0.0, 1.0), (1.0, 0.55)], scale: 0.2), curl: -30.0))),
                attach: End,
                offset: (rotate_deg: (-35.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.17, 0.15, 0.2)),
                            snout: 0.38,
                            jaw: Some((segments: 1, length: 0.45)),
                            eye_spacing: 0.7,
                            eye_lateral: 0.6,
                            // A wide, flat, wedge-shaped snout with flared nostrils and heavy jaw muscles.
                            muzzle: (base: (0.75, 0.55), tip: (0.55, 0.32), rise: 0.05, cheek: 0.6, nostrils: 0.5, jaw_width: 1.3),
                        )),
                        offset: (rotate_deg: (30.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.045)), attach: Eye, mirror: true),
                            (name: "horn", kind: Hard((kind: Horn, size: 0.4, curve: 0.5)), attach: Horn, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                name: "wing",
                kind: Wing((
                    kind: Membrane((fingers: 3, trailing: HindLeg, scallop: 0.25, thumb: true)),
                    span: 2.6,
                    chord: 1.3,
                    fold: 1.0,
                    sweep_deg: 12.0,
                    radius: 0.07,
                )),
                attach: Surface(t: 0.82, around_deg: 60.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "limb.front",
                kind: Limb((
                    chain: (segments: 3, length: 1.0, ratios: [1.0, 1.05, 0.4], radius: (curve: [(0.0, 1.0), (0.4, 0.62), (0.75, 0.5), (1.0, 0.45)], scale: 0.12)),
                    role: Locomotor,
                    stance: Digitigrade,
                    end: Pad,
                    bends: [(-25.0, 0.0), (30.0, 0.0), (12.0, 0.0)],
                )),
                attach: Surface(t: 0.88, around_deg: 135.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "limb.hind",
                kind: Limb((
                    chain: (segments: 3, length: 1.2, ratios: [1.0, 1.1, 0.55], radius: (curve: [(0.0, 1.25), (0.35, 0.75), (0.7, 0.5), (1.0, 0.42)], scale: 0.12)),
                    role: Locomotor,
                    stance: Digitigrade,
                    end: Pad,
                    bends: [(30.0, 0.0), (-70.0, 0.0), (46.0, 0.0)],
                )),
                attach: Surface(t: 0.1, around_deg: 120.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 6, length: 2.2, radius: (curve: [(0.0, 1.0), (1.0, 0.12)], scale: 0.16), curl: 10.0))),
                attach: Start,
                offset: (rotate_deg: (15.0, 0.0, 0.0)),
            ),
        ],
    ),
    tone: (muscle: 0.6, fat: 0.15, landmarks: 0.5),
)
