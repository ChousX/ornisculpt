// An unguligrade quadruped on horse proportions (withers ~1.5 m; see
// docs/design/anatomy-reference.md). A "square" horse: withers height ≈ body length; chest
// depth ≈ the leg from elbow to ground; neck ≈ 1/3 of body length; forearm longer than cannon;
// standing on single hooves at the end of a sloped pastern.
(
    root: (
        name: "torso",
        kind: Torso((
            // Croup → loin → barrel → chest; deep, slightly narrower than tall.
            chain: (segments: 4, length: 1.3, radius: (curve: [(0.0, 0.85), (0.3, 0.86), (0.6, 1.0), (0.85, 0.98), (1.0, 0.82)], scale: 0.3, cross: Ellipse(aspect: 0.82))),
            arch: [(0.0, 0.0), (0.3, -0.03), (0.6, -0.05), (1.0, 0.0)],
            belly: 0.3,
        )),
        detail: Always,
        children: [
            (
                // Carried ~45° up; thick at the base, narrowing to the throatlatch.
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 3, length: 0.7, radius: (curve: [(0.0, 1.0), (0.6, 0.62), (1.0, 0.5)], scale: 0.2, cross: Ellipse(aspect: 0.6)), curl: -25.0))),
                attach: End,
                offset: (rotate_deg: (-50.0, 0.0, 0.0), translate: (0.0, 0.0, 0.08)),
                detail: Always,
                children: [
                    (
                        // ≈ 0.4 of withers height, long and narrow, held angled down.
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.1, 0.11, 0.13)),
                            snout: 0.33,
                            jaw: Some((segments: 1, length: 0.38)),
                            eye_spacing: 0.85,
                            eye_lateral: 0.9,
                        )),
                        offset: (rotate_deg: (35.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.025)), attach: Eye, mirror: true),
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 2, length: 0.15, radius: (curve: [(0.0, 0.6), (0.4, 1.0), (1.0, 0.2)], scale: 0.035, cross: Flat(aspect: 2.0)), blend: 0.01))), attach: Ear, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                // Humerus back (elbow back), forearm vertical and longer than the cannon,
                // pastern sloping forward onto the hoof.
                name: "limb.front",
                kind: Limb((
                    chain: (segments: 4, length: 1.08, ratios: [0.8, 1.0, 0.62, 0.28], radius: (curve: [(0.0, 1.0), (0.3, 0.75), (0.5, 0.45), (0.85, 0.38), (1.0, 0.42)], scale: 0.1)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: false),
                    bends: [(-32.0, 0.0), (34.0, 0.0), (0.0, 0.0), (38.0, 0.0)],
                )),
                attach: Surface(t: 0.88, around_deg: 140.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Femur forward (stifle forward), tibia back, long hind cannon to the hock,
                // pastern forward.
                name: "limb.hind",
                kind: Limb((
                    chain: (segments: 4, length: 1.3, ratios: [1.0, 1.1, 0.8, 0.28], radius: (curve: [(0.0, 1.35), (0.3, 0.75), (0.55, 0.45), (0.85, 0.38), (1.0, 0.42)], scale: 0.1)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: false),
                    bends: [(28.0, 0.0), (-66.0, 0.0), (38.0, 0.0), (36.0, 0.0)],
                )),
                attach: Surface(t: 0.1, around_deg: 125.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 3, length: 0.45, radius: (curve: [(0.0, 1.0), (1.0, 0.5)], scale: 0.05), curl: 60.0))),
                attach: Start,
                offset: (rotate_deg: (40.0, 0.0, 0.0)),
            ),
        ],
    ),
    tone: (muscle: 0.7, fat: 0.15),
)
