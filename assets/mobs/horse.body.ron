// An unguligrade quadruped on horse proportions (withers ~1.5 m; see
// docs/design/anatomy-reference.md). A "square" horse: withers height ≈ body length; chest
// depth ≈ the leg from elbow to ground; neck ≈ 1/3 of body length; forearm longer than cannon;
// standing on single hooves at the end of a sloped pastern.
(
    root: (
        name: "torso",
        kind: Torso((
            // Croup → loin → barrel → chest; deep, slightly narrower than tall. The sections
            // keep the back flat (each `drop` ≈ (depth − 1) × 1.1, the ellipse's height
            // factor) while the underline tucks up at the flank and hangs low at the girth and
            // the brisket; wide quarters and barrel, a narrow chest between the forelegs.
            chain: (segments: 4, length: 1.3, radius: (
                curve: [(0.0, 0.85), (0.3, 0.86), (0.6, 1.0), (0.85, 0.98), (1.0, 0.82)], scale: 0.3, cross: Ellipse(aspect: 0.82),
                width: [(0.0, 1.1), (0.2, 0.95), (0.55, 1.12), (0.85, 0.88), (1.0, 0.8)],
                depth: [(0.0, 1.05), (0.2, 0.85), (0.5, 1.12), (0.75, 1.28), (0.9, 1.28), (1.0, 1.1)],
                drop: [(0.0, 0.05), (0.2, -0.17), (0.5, 0.13), (0.75, 0.31), (0.9, 0.31), (1.0, 0.11)],
            )),
            arch: [(0.0, 0.0), (0.3, -0.03), (0.6, -0.05), (1.0, 0.0)],
            belly: 0.3,
        )),
        detail: Always,
        children: [
            (
                // Carried ~45° up; thick at the base, narrowing to the throatlatch.
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 3, length: 0.75, radius: (curve: [(0.0, 1.15), (0.45, 0.8), (1.0, 0.55)], scale: 0.21, cross: Ellipse(aspect: 0.55)), curl: -25.0))),
                attach: End,
                offset: (rotate_deg: (-50.0, 0.0, 0.0), translate: (0.0, 0.0, 0.08)),
                detail: Always,
                children: [
                    (
                        // ≈ 0.4 of withers height, long and narrow, held angled down.
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.13, 0.12, 0.14)),
                            snout: 0.4,
                            jaw: Some((segments: 1, length: 0.38)),
                            eye_spacing: 0.74,
                            eye_lateral: 0.9,
                            pitch: 40.0,
                            // Long and wedge-shaped: deep, flat cheeks at the back, a straight nose
                            // line running on from the forehead, flared nostrils and soft lips.
                            muzzle: (
                                base: (0.8, 0.75),
                                tip: (0.5, 0.42),
                                rise: 0.22,
                                drop: 5.0,
                                cheek: 1.0,
                                nostrils: 1.5,
                                lips: 0.6,
                                jaw_depth: 1.8,
                            ),
                        )),
                        offset: (rotate_deg: (35.0, 0.0, 0.0), translate: (0.0, 0.0, 0.06)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.025)), attach: Eye, mirror: true),
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 2, length: 0.13, radius: (curve: [(0.0, 0.7), (0.4, 1.0), (1.0, 0.15)], scale: 0.03, cross: Flat(aspect: 1.8)), curl: 40.0, blend: 0.01))), attach: Ear, mirror: true),
                            // Forelock: hair from the poll falling over the forehead.
                            (name: "forelock", kind: Mass((shape: Ellipsoid, size: (0.04, 0.018, 0.09), blend: 0.02)), attach: Crown, offset: (translate: (0.0, -0.022, 0.035))),
                        ],
                    ),
                    // Mane: hair standing along the crest of the neck, falling a little to one side.
                    (name: "mane", kind: Mass((shape: Crest, size: (0.1, 0.12, 0.15), blend: 0.03)), attach: Surface(t: 0.1, around_deg: 8.0), offset: (translate: (0.0, -0.03, 0.0)), repeat: Series(count: 6, from: 0.08, to: 0.95)),
                ],
            ),
            (
                // Humerus back (elbow back), forearm vertical and longer than the cannon,
                // pastern sloping forward onto the hoof.
                name: "limb.front",
                kind: Limb((
                    chain: (segments: 4, length: 1.08, ratios: [0.8, 1.0, 0.62, 0.28], radius: (curve: [(0.0, 1.0), (0.3, 0.8), (0.5, 0.45), (0.85, 0.38), (1.0, 0.42)], scale: 0.1)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: false),
                    joints: Some((plan: Foreleg, swing: -32.0, flex: [34.0, 0.0, -38.0])),
                )),
                attach: Surface(t: 0.88, around_deg: 130.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Femur forward (stifle forward), tibia back, long hind cannon to the hock,
                // pastern forward.
                name: "limb.hind",
                kind: Limb((
                    chain: (segments: 4, length: 1.3, ratios: [1.0, 1.1, 0.8, 0.28], radius: (curve: [(0.0, 1.35), (0.3, 0.8), (0.55, 0.45), (0.85, 0.38), (1.0, 0.42)], scale: 0.1)),
                    role: Locomotor,
                    stance: Unguligrade,
                    end: Hoof(split: false),
                    joints: Some((plan: Hindleg, swing: 28.0, flex: [66.0, 38.0, -36.0])),
                )),
                attach: Surface(t: 0.1, around_deg: 125.0),
                mirror: true,
                detail: Always,
            ),
            (
                // The dock, then the hair falling nearly to the hocks: full and flattened side to side.
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 4, length: 1.1, ratios: [0.6, 1.0, 1.0, 1.0], radius: (curve: [(0.0, 1.0), (0.18, 0.8), (0.5, 1.1), (0.85, 0.95), (1.0, 0.45)], scale: 0.05, cross: Ellipse(aspect: 0.45)), curl: 85.0))),
                attach: Start,
                offset: (rotate_deg: (35.0, 0.0, 0.0), translate: (0.0, 0.0, -0.1)),
            ),
        ],
    ),
    tone: (muscle: 0.7, fat: 0.15),
)
