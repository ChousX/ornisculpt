// A wolf spider (Lycosidae) at mob scale: body ~0.6 m. Two tagmata joined by a narrow pedicel:
// the prosoma (~0.45 of the body, all eight legs, the pedipalps, the chelicerae with their fangs
// and the eyes) and a legless, egg-shaped opisthosoma. Legs ~1.3–1.5 × the body, IV the longest,
// then I; femur raised, the patella-tibia "knee" high, metatarsus and tarsus down to the ground.
// Eight eyes in three rows: four small in front, two big forward-facing above them, two on top.
(
    root: (
        name: "prosoma",
        kind: Torso((
            chain: (segments: 2, length: 0.25, radius: (curve: [(0.0, 0.7), (0.45, 1.0), (1.0, 0.72)], scale: 0.085, cross: Ellipse(aspect: 1.25))),
            arch: [(0.0, -0.01), (0.6, 0.012), (1.0, 0.0)],
        )),
        detail: Always,
        children: [
            (
                // The eye-bearing front of the prosoma (spiders have no separate head).
                name: "head",
                kind: Head((skull: (shape: Ellipsoid, size: (0.06, 0.05, 0.05)), snout: 0.0, jaw: None, eye_spacing: 0.45, eye_lateral: 0.15)),
                attach: End,
                offset: (translate: (0.0, 0.0, -0.035), rotate_deg: (-10.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    // Posterior median eyes: the big forward-facing pair.
                    (name: "eye.pm", kind: Hard((kind: Eye, size: 0.022)), attach: Eye, mirror: true),
                    // Posterior lateral eyes: on top, looking up and back.
                    (name: "eye.pl", kind: Hard((kind: Eye, size: 0.016)), attach: Eye, offset: (translate: (0.012, -0.03, -0.035)), mirror: true),
                    // Anterior row: four small eyes below the big pair.
                    (name: "eye.am", kind: Hard((kind: Eye, size: 0.008)), attach: Eye, offset: (translate: (-0.012, 0.0, 0.03)), mirror: true),
                    (name: "eye.al", kind: Hard((kind: Eye, size: 0.008)), attach: Eye, offset: (translate: (0.006, 0.0, 0.032)), mirror: true),
                    // Chelicerae: stout, hairy, hanging under the eyes, each with a curved fang.
                    (name: "chelicera", kind: Mass((shape: Ellipsoid, size: (0.022, 0.045, 0.028), blend: 0.012)), attach: Mouth, offset: (translate: (0.022, 0.0, -0.01), rotate_deg: (60.0, 0.0, 0.0)), mirror: true, children: [
                        (name: "fang", kind: Hard((kind: Fang, size: 0.026, curve: 0.5)), attach: End, offset: (rotate_deg: (0.0, 0.0, 20.0))),
                    ]),
                ],
            ),
            (
                // Egg-shaped, hairy, joined by a narrow pedicel.
                name: "opisthosoma",
                kind: Chain((role: Tail, chain: (segments: 2, length: 0.34, radius: (curve: [(0.0, 0.18), (0.12, 0.78), (0.4, 1.0), (0.8, 0.82), (1.0, 0.35)], scale: 0.13, cross: Ellipse(aspect: 1.15)), curl: -12.0, blend: 0.006))),
                attach: Start,
                offset: (rotate_deg: (-6.0, 0.0, 0.0)),
                detail: Always,
            ),
            (
                // Pedipalps: short leg-like feelers either side of the chelicerae.
                name: "pedipalp",
                kind: Limb((chain: (segments: 3, length: 0.16, ratios: [1.0, 0.8, 0.7], segmented: 0.6, radius: (curve: [(0.0, 1.0), (1.0, 0.75)], scale: 0.011)), role: Display, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 20.0, flex: [80.0, 30.0])))),
                attach: Surface(t: 0.95, around_deg: 120.0),
                offset: (rotate_deg: (70.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "leg.1",
                kind: Limb((chain: (segments: 3, length: 0.8, ratios: [1.0, 1.25, 1.05], segmented: 0.75, radius: (curve: [(0.0, 1.0), (0.4, 0.75), (1.0, 0.4)], scale: 0.022)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 58.0, flex: [100.0, 38.0])))),
                attach: Surface(t: 0.82, around_deg: 100.0),
                offset: (rotate_deg: (50.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "leg.2",
                kind: Limb((chain: (segments: 3, length: 0.72, ratios: [1.0, 1.25, 1.05], segmented: 0.75, radius: (curve: [(0.0, 1.0), (0.4, 0.75), (1.0, 0.4)], scale: 0.021)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 58.0, flex: [100.0, 38.0])))),
                attach: Surface(t: 0.62, around_deg: 100.0),
                offset: (rotate_deg: (18.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "leg.3",
                kind: Limb((chain: (segments: 3, length: 0.7, ratios: [1.0, 1.2, 1.1], segmented: 0.75, radius: (curve: [(0.0, 1.0), (0.4, 0.75), (1.0, 0.4)], scale: 0.021)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 58.0, flex: [100.0, 38.0])))),
                attach: Surface(t: 0.42, around_deg: 100.0),
                offset: (rotate_deg: (-18.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "leg.4",
                kind: Limb((chain: (segments: 3, length: 0.9, ratios: [1.0, 1.2, 1.2], segmented: 0.75, radius: (curve: [(0.0, 1.0), (0.4, 0.75), (1.0, 0.4)], scale: 0.022)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 58.0, flex: [100.0, 38.0])))),
                attach: Surface(t: 0.22, around_deg: 100.0),
                offset: (rotate_deg: (-50.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
        ],
    ),
    tone: (muscle: 0.1, fat: 0.1, folds: 0.0, landmarks: 0.3),
)
