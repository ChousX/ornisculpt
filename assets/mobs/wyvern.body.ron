// A wyvern on pterosaur lines: two legs and wings carried by one enormous fourth finger, the
// membrane running from its tip back to the hind leg, a smooth (unscalloped) trailing edge.
// A long tail balances the body over the hips. See docs/design/wings.md.
(
    root: (
        name: "torso",
        kind: Torso((
            chain: (segments: 4, length: 1.1, radius: (curve: [(0.0, 0.7), (0.4, 0.95), (0.75, 1.0), (1.0, 0.8)], scale: 0.24, cross: Ellipse(aspect: 0.85))),
            arch: [(0.0, -0.05), (0.5, 0.03), (1.0, 0.06)],
            belly: 0.2,
        )),
        detail: Always,
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 3, length: 0.75, radius: (curve: [(0.0, 1.0), (1.0, 0.55)], scale: 0.14), curl: -40.0))),
                attach: End,
                offset: (rotate_deg: (-30.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.12, 0.11, 0.15)),
                            snout: 0.3,
                            jaw: Some((segments: 1, length: 0.34)),
                            eye_spacing: 0.7,
                            eye_lateral: 0.6,
                            // A long, flat, narrow snout.
                            muzzle: (base: (0.65, 0.5), tip: (0.45, 0.28), rise: 0.05, cheek: 0.4, nostrils: 0.6, jaw_depth: 1.2, jaw_width: 1.2),
                        )),
                        offset: (rotate_deg: (30.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.035)), attach: Eye, mirror: true),
                            (name: "horn", kind: Hard((kind: Horn, size: 0.22, curve: 0.3)), attach: Horn, mirror: true),
                        ],
                    ),
                ],
            ),
            (
                name: "wing",
                kind: Wing((
                    kind: Membrane((fingers: 1, trailing: HindLeg, scallop: 0.05, thumb: true)),
                    span: 2.4,
                    chord: 0.9,
                    fold: 1.0,
                    sweep_deg: 8.0,
                    radius: 0.055,
                )),
                attach: Surface(t: 0.85, around_deg: 60.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Theropod-style hind legs: femur forward, long shin back, long metatarsus.
                name: "leg",
                kind: Limb((
                    chain: (segments: 3, length: 1.15, ratios: [1.0, 1.15, 0.6], radius: (curve: [(0.0, 1.3), (0.35, 0.75), (0.7, 0.5), (1.0, 0.42)], scale: 0.1)),
                    role: Locomotor,
                    stance: Digitigrade,
                    end: Pad,
                    joints: Some((plan: Hindleg, swing: 35.0, flex: [75.0, 50.0])),
                )),
                attach: Surface(t: 0.32, around_deg: 120.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 6, length: 1.7, radius: (curve: [(0.0, 1.0), (1.0, 0.1)], scale: 0.13), curl: 8.0))),
                attach: Start,
            ),
        ],
    ),
    tone: (muscle: 0.6, fat: 0.1, landmarks: 0.5),
)
