// An adult man, stature 1.78 m, on the segment fractions in docs/design/anatomy-reference.md
// (Drillis & Contini): legs (hip joint to sole) 0.53 H, thigh ≈ shank ≈ 0.245 H, upper arm
// 0.186 H, forearm 0.146 H, hand 0.108 H; shoulders 0.259 H across the acromions (wider over the
// deltoids), hips 0.191 H; head ≈ 1/7.5 H. A lean, active build: broad shoulders over a deep
// chest, a narrower waist, a neck as thick as the head is deep at the jaw. Short hair.
//
// The torso stands vertically: t = 0 is the pelvis, 1 the shoulders; around 0 = back, 90 = left,
// 180 = front.
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → ribcage → shoulders: the V of a man's trunk, widest over the
            // shoulders, ~1.5× wider than deep.
            chain: (segments: 3, length: 0.56, radius: (curve: [(0.0, 0.95), (0.18, 0.92), (0.38, 0.84), (0.62, 0.98), (0.82, 1.05), (0.92, 1.0), (1.0, 0.56)], scale: 0.138, cross: Ellipse(aspect: 1.55))),
            belly: 0.1,
        )),
        offset: (rotate_deg: (-90.0, 0.0, 0.0)),
        detail: Always,
        stamps: Custom([
            (at: Surface(t: 0.8, around_deg: 152.0), kind: Muscle, size: (0.72, 0.5, 0.4), depth: 0.08, mirror: true),  // pectorals
            (at: Surface(t: 0.93, around_deg: 100.0), kind: Muscle, size: (0.34, 0.32, 0.3), depth: 0.06, mirror: true), // top of the shoulder
            (at: Surface(t: 0.97, around_deg: 30.0), kind: Muscle, size: (0.55, 0.38, 0.35), depth: 0.1, mirror: true),   // trapezius
            (at: Surface(t: 0.8, around_deg: 35.0), kind: Landmark, size: (0.28, 0.4, 0.15), depth: 0.03, mirror: true), // shoulder blade
            (at: Surface(t: 0.62, around_deg: 70.0), kind: Muscle, size: (0.45, 0.7, 0.3), depth: 0.04, mirror: true),  // lats
            (at: Surface(t: 0.5, around_deg: 15.0), kind: Muscle, size: (0.16, 1.6, 0.2), depth: 0.05, mirror: true),   // ridges either side of the spine
            (at: Surface(t: 0.45, around_deg: 170.0), kind: Muscle, size: (0.24, 0.95, 0.22), depth: 0.018, mirror: true), // rectus abdominis
            (at: Surface(t: 0.6, around_deg: 130.0), kind: Landmark, size: (0.5, 0.3, 0.15), depth: 0.02, mirror: true), // lower ribs
            (at: Surface(t: 0.12, around_deg: 30.0), kind: Muscle, size: (0.6, 0.6, 0.48), depth: 0.08, mirror: true),  // buttock
            (at: Surface(t: 0.2, around_deg: 115.0), kind: Landmark, size: (0.3, 0.25, 0.15), depth: 0.025, mirror: true), // hip bone (iliac crest)
            (at: Surface(t: 0.38, around_deg: 180.0), kind: Fat, size: (0.55, 0.6, 0.4), depth: 0.03, mirror: false),  // belly
        ]),
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.11, radius: (curve: [(0.0, 1.25), (0.4, 0.98), (1.0, 0.92)], scale: 0.056, cross: Ellipse(aspect: 1.1))))),
                attach: End,
                offset: (rotate_deg: (8.0, 0.0, 0.0)),
                detail: Always,
                stamps: Custom([
                    (at: Surface(t: 0.5, around_deg: 150.0), kind: Muscle, size: (0.25, 1.3, 0.25), depth: 0.05, mirror: true), // sternocleidomastoid
                    (at: Surface(t: 0.55, around_deg: 180.0), kind: Landmark, size: (0.25, 0.25, 0.2), depth: 0.05, mirror: false), // Adam's apple
                ]),
                children: [
                    (
                        name: "head",
                        kind: Head((
                            // The authored head (MakeHuman's, CC0), 22 cm tall.
                            skull: (shape: Ellipsoid, size: (0.088, 0.11, 0.104)),
                            snout: 0.0,
                            eye_spacing: 0.42,
                            sculpt: Some(()),
                        )),
                        offset: (rotate_deg: (-6.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.0138, sclera: 1.0)), attach: Eye, mirror: true),
                            // Short hair: a cap over the crown and back of the skull.
                            (name: "hair", kind: Mass((shape: Ellipsoid, size: (0.084, 0.066, 0.098), blend: 0.008)), attach: Crown, offset: (translate: (0.0, -0.055, -0.03))),
                        ],
                    ),
                ],
            ),
            (
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.88, ratios: [1.0, 1.0], radius: (curve: [(0.0, 1.05), (0.22, 0.9), (0.45, 0.64), (0.56, 0.66), (0.7, 0.64), (1.0, 0.38)], scale: 0.085)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.26),
                    joints: Some((plan: Leg, swing: 6.0, flex: [8.0])),
                )),
                attach: Surface(t: 0.05, around_deg: 118.0),
                offset: (translate: (0.0, -0.04, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.6, ratios: [1.0, 0.78], radius: (curve: [(0.0, 1.2), (0.25, 1.0), (0.5, 0.74), (0.62, 0.84), (1.0, 0.54)], scale: 0.052)),
                    role: Manipulator,
                    end: Hand(palm: 0.1),
                    joints: Some((plan: Arm, swing: 3.0, flex: [18.0])),
                    splay_deg: 5.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                // Turned so the palms face the thighs.
                offset: (translate: (0.0, 0.035, 0.0), rotate_deg: (0.0, 75.0, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.095, ratios: [1.0, 0.66, 0.55], radius: (curve: [(0.0, 1.0), (1.0, 0.8)], scale: 0.0095), curl: 600.0), spread_deg: 4.0, opposable: true, tip: Some((kind: Nail, size: 0.009)))),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.75, fat: 0.18, landmarks: 0.4),
)
