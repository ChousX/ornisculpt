// An adult woman, stature 1.65 m, on the same segment fractions as the man (docs/design/
// anatomy-reference.md), with a woman's build: shoulders about as wide as the hips, a waist ~0.75
// of the hips, wider pelvis and thighs, breasts, a smaller ribcage and lighter limbs, more fat
// over the hips, buttocks and thighs. Softer face: smaller brow and jaw, fuller lips. Long hair
// tied back.
//
// The torso stands vertically: t = 0 is the pelvis, 1 the shoulders; around 0 = back, 90 = left,
// 180 = front.
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → ribcage → shoulders: an hourglass, the hips as wide as the shoulders.
            chain: (segments: 3, length: 0.5, radius: (curve: [(0.0, 0.84), (0.12, 1.12), (0.26, 1.02), (0.44, 0.7), (0.62, 0.84), (0.8, 0.94), (0.92, 0.88), (1.0, 0.5)], scale: 0.125, cross: Ellipse(aspect: 1.55))),
            belly: 0.08,
        )),
        offset: (rotate_deg: (-90.0, 0.0, 0.0)),
        detail: Always,
        stamps: Custom([
            (at: Surface(t: 0.72, around_deg: 148.0), kind: Fat, size: (0.54, 0.6, 0.42), depth: 0.06, mirror: true, form: Drop, hang: 0.15, soft: (firmness: 0.9)), // breast
            (at: Surface(t: 0.85, around_deg: 150.0), kind: Muscle, size: (0.6, 0.4, 0.35), depth: 0.03, mirror: true), // pectoral above it
            (at: Surface(t: 0.93, around_deg: 100.0), kind: Muscle, size: (0.3, 0.3, 0.3), depth: 0.035, mirror: true), // top of the shoulder
            (at: Surface(t: 0.97, around_deg: 30.0), kind: Muscle, size: (0.5, 0.35, 0.3), depth: 0.05, mirror: true),  // trapezius
            (at: Surface(t: 0.8, around_deg: 35.0), kind: Landmark, size: (0.28, 0.4, 0.15), depth: 0.02, mirror: true), // shoulder blade
            (at: Surface(t: 0.5, around_deg: 15.0), kind: Muscle, size: (0.16, 1.5, 0.2), depth: 0.03, mirror: true),  // ridges either side of the spine
            (at: Surface(t: 0.1, around_deg: 32.0), kind: Fat, size: (0.58, 0.6, 0.5), depth: 0.0, mirror: true, form: Drop, hang: 0.15), // buttock
            (at: Surface(t: 0.16, around_deg: 30.0), kind: Muscle, size: (0.5, 0.45, 0.4), depth: 0.04, mirror: true),  // glute under it
            (at: Surface(t: 0.11, around_deg: 84.0), kind: Fat, size: (0.5, 0.6, 0.45), depth: 0.16, mirror: true),     // hip
            (at: Surface(t: 0.3, around_deg: 180.0), kind: Fat, size: (0.6, 0.5, 0.45), depth: 0.03, mirror: false),    // soft belly
        ]),
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.115, radius: (curve: [(0.0, 1.2), (0.4, 0.95), (1.0, 0.9)], scale: 0.043, cross: Ellipse(aspect: 1.05))))),
                attach: End,
                offset: (rotate_deg: (8.0, 0.0, 0.0)),
                detail: Always,
                stamps: Custom([
                    (at: Surface(t: 0.5, around_deg: 150.0), kind: Muscle, size: (0.25, 1.3, 0.25), depth: 0.03, mirror: true), // sternocleidomastoid
                ]),
                children: [
                    (
                        name: "head",
                        kind: Head((
                            // The authored head (MakeHuman's, CC0), 21 cm tall.
                            skull: (shape: Ellipsoid, size: (0.084, 0.105, 0.099)),
                            snout: 0.0,
                            eye_spacing: 0.42,
                            sculpt: Some(()),
                        )),
                        offset: (rotate_deg: (-6.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.013, sclera: 1.0)), attach: Eye, mirror: true),
                            // Long hair: a cap over the crown, sides and back of the skull, and the
                            // fall behind the shoulders to the middle of the back.
                            (name: "hair", kind: Mass((shape: Ellipsoid, size: (0.082, 0.065, 0.095), blend: 0.01)), attach: Crown, offset: (translate: (0.0, -0.055, -0.03))),
                            // A broad, flat sheet hanging from the back of the head; it swings.
                            (name: "fall", kind: Chain((role: Tail, chain: (segments: 3, length: 0.36, radius: (curve: [(0.0, 1.0), (0.3, 1.1), (1.0, 0.7)], scale: 0.055, cross: Ellipse(aspect: 3.0)), curl: 30.0, blend: 0.02))), attach: Crown, offset: (translate: (0.0, -0.05, -0.09), rotate_deg: (-168.0, 0.0, 0.0))),
                        ],
                    ),
                ],
            ),
            (
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.82, ratios: [1.0, 1.0], radius: (curve: [(0.0, 1.12), (0.2, 1.0), (0.44, 0.66), (0.56, 0.62), (0.7, 0.6), (1.0, 0.36)], scale: 0.088)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.23),
                    joints: Some((plan: Leg, swing: 6.0, flex: [8.0])),
                )),
                stamps: Custom([
                    (at: Surface(t: 0.22, around_deg: 180.0), kind: Muscle, size: (0.6, 1.8, 0.3), depth: 0.03),   // front of thigh
                    (at: Surface(t: 0.22, around_deg: 0.0), kind: Muscle, size: (0.6, 1.8, 0.3), depth: 0.025),    // back of thigh
                    (at: Surface(t: 0.12, around_deg: 255.0), kind: Fat, size: (0.6, 1.0, 0.45), depth: 0.1),      // outer thigh
                    (at: Surface(t: 0.14, around_deg: 110.0), kind: Fat, size: (0.45, 0.9, 0.4), depth: 0.05),     // inner thigh
                    (at: Surface(t: 0.65, around_deg: 0.0), kind: Muscle, size: (0.5, 1.3, 0.3), depth: 0.05),     // calf
                    (at: Surface(t: 0.5, around_deg: 90.0), kind: Landmark, size: (0.3, 0.4, 0.2), depth: 0.02),   // inner knee
                    (at: Surface(t: 0.5, around_deg: 270.0), kind: Landmark, size: (0.3, 0.4, 0.2), depth: 0.02),  // outer knee
                ]),
                attach: Surface(t: 0.04, around_deg: 116.0),
                offset: (translate: (0.0, -0.04, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.55, ratios: [1.0, 0.78], radius: (curve: [(0.0, 1.15), (0.3, 0.92), (0.5, 0.72), (0.62, 0.78), (1.0, 0.5)], scale: 0.046)),
                    role: Manipulator,
                    end: Hand(palm: 0.088),
                    joints: Some((plan: Arm, swing: 3.0, flex: [20.0])),
                    splay_deg: 5.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                // Turned so the palms face the thighs.
                offset: (translate: (0.0, 0.035, 0.0), rotate_deg: (0.0, 75.0, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.088, ratios: [1.0, 0.66, 0.55], radius: (curve: [(0.0, 1.0), (1.0, 0.8)], scale: 0.0083), curl: 600.0), spread_deg: 4.0, opposable: true, tip: Some((kind: Nail, size: 0.008)))),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.5, fat: 0.4, landmarks: 0.3),
)
