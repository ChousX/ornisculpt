// A goblin (fantasy): a small, wiry humanoid about 1.1 m tall, all sinew and joints. A big head
// for the body (about 1/5 of stature) with huge pointed ears swept out to the sides, large eyes,
// a long hooked nose, a wide thin-lipped mouth and a sharp chin (an authored head, the human one
// warped). Narrow shoulders, a pot belly,
// long thin arms reaching the knees with long-fingered clawed hands, bandy legs bent at the knee.
// Hunched: the trunk leans forward and the head juts.
//
// The torso stands vertically (t = 0 pelvis, 1 shoulders; around 0 = back, 90 = left, 180 = front).
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → ribcage → shoulders: the V of a man's trunk, widest over the
            // shoulders, ~1.5× wider than deep.
            chain: (segments: 3, length: 0.38, radius: (curve: [(0.0, 0.92), (0.2, 0.95), (0.42, 1.0), (0.65, 0.88), (0.85, 0.9), (1.0, 0.55)], scale: 0.088, cross: Ellipse(aspect: 1.3))),
            belly: 0.45,
        )),
        offset: (rotate_deg: (-68.0, 0.0, 0.0)),
        detail: Always,
        stamps: Custom([
            (at: Surface(t: 0.4, around_deg: 180.0), kind: Fat, size: (0.6, 0.55, 0.5), depth: 0.12, mirror: false, form: Mass, hang: 0.2), // pot belly
            (at: Surface(t: 0.6, around_deg: 120.0), kind: Landmark, size: (0.55, 0.4, 0.12), depth: 0.04, mirror: true),  // ribs
            (at: Surface(t: 0.82, around_deg: 30.0), kind: Landmark, size: (0.32, 0.42, 0.18), depth: 0.06, mirror: true), // shoulder blades
            (at: Surface(t: 0.55, around_deg: 0.0), kind: Landmark, size: (0.1, 1.6, 0.15), depth: 0.05, mirror: false),   // spine
            (at: Surface(t: 0.22, around_deg: 110.0), kind: Landmark, size: (0.3, 0.25, 0.15), depth: 0.04, mirror: true), // hip bones
        ]),
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.09, radius: (curve: [(0.0, 1.15), (0.4, 0.95), (1.0, 0.95)], scale: 0.04, cross: Ellipse(aspect: 1.1))))),
                attach: End,
                offset: (rotate_deg: (35.0, 0.0, 0.0)),
                detail: Always,
                stamps: Custom([
                    (at: Surface(t: 0.5, around_deg: 150.0), kind: Muscle, size: (0.25, 1.3, 0.25), depth: 0.07, mirror: true), // stringy neck muscles
                ]),
                children: [
                    (
                        name: "head",
                        kind: Head((
                            // The authored goblin head (parts/head_goblin.gltf, tools/gen_head_goblin.py:
                            // the MakeHuman head warped), 18 cm tall.
                            skull: (shape: Ellipsoid, size: (0.072, 0.09, 0.092)),
                            snout: 0.0,
                            eye_spacing: 0.5,
                            sculpt: Some((
                                mesh: "parts/head_goblin.gltf#Mesh0/Primitive0",
                                blend: 0.055,
                                eye_radius: 0.018,
                                eye: (0.0312, 0.0943, 0.0372),
                                nostril: (0.009, 0.0437, 0.1031),
                                nose: (0.0, 0.0378, 0.1689),
                                mouth: (0.0, 0.0346, 0.0944),
                            )),
                        )),
                        offset: (rotate_deg: (-30.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.018, sclera: 0.45)), attach: Eye, mirror: true),
                            // Huge pointed ears, out to the sides and up a little, drooping at the tips.
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 3, length: 0.17, radius: (curve: [(0.0, 0.8), (0.3, 1.0), (1.0, 0.08)], scale: 0.028, cross: Flat(aspect: 3.2)), curl: 60.0, blend: 0.006))), attach: Ear, offset: (rotate_deg: (-25.0, 0.0, 60.0)), mirror: true),
                        ],
                    ),
                ],
            ),
            (
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.5, ratios: [1.0, 1.0], radius: (curve: [(0.0, 1.0), (0.25, 0.75), (0.45, 0.55), (0.52, 0.62), (0.7, 0.58), (1.0, 0.4)], scale: 0.052)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.19),
                    joints: Some((plan: Leg, swing: 30.0, flex: [50.0])),
                )),
                attach: Surface(t: 0.05, around_deg: 112.0),
                offset: (translate: (0.0, -0.04, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.52, ratios: [1.0, 0.95], radius: (curve: [(0.0, 1.1), (0.3, 0.8), (0.48, 0.6), (0.58, 0.75), (1.0, 0.5)], scale: 0.034)),
                    role: Manipulator,
                    end: Hand(palm: 0.07),
                    joints: Some((plan: Arm, swing: 15.0, flex: [25.0])),
                    splay_deg: 10.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                // Turned so the palms face the thighs.
                offset: (translate: (0.0, 0.035, 0.0), rotate_deg: (0.0, 75.0, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.09, ratios: [1.0, 0.7, 0.6], radius: (curve: [(0.0, 1.0), (1.0, 0.7)], scale: 0.0065), curl: 380.0), spread_deg: 8.0, opposable: true, tip: Some((kind: Claw, size: 0.012, curve: 0.4)))),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 0.45, fat: 0.05, landmarks: 0.9),
)
