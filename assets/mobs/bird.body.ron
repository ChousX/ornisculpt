// A large raptor: horizontal body, S-curved neck, hooked beak, digitigrade legs, and feathered
// wings with slotted (fingered) primaries, folded in a Z along the flanks. Wear
// coats/bird.coat.ron for body feathers. See docs/design/wings.md.
(
    root: (
        name: "torso",
        kind: Torso((
            chain: (segments: 3, length: 0.55, radius: (curve: [(0.0, 0.6), (0.5, 1.0), (1.0, 0.85)], scale: 0.13, cross: Teardrop(aspect: 0.9))),
            arch: [(0.0, -0.03), (1.0, 0.05)],
        )),
        detail: Always,
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 3, length: 0.2, radius: (curve: [(0.0, 1.0), (1.0, 0.7)], scale: 0.06), curl: -120.0))),
                attach: End,
                offset: (rotate_deg: (-60.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (
                        name: "head",
                        kind: Head((skull: (shape: Ellipsoid, size: (0.055, 0.055, 0.065)), snout: 0.0, jaw: None, eye_spacing: 0.75, eye_lateral: 0.5)),
                        offset: (rotate_deg: (50.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.016)), attach: Eye, mirror: true),
                            (name: "beak", kind: Hard((kind: Beak, size: 0.07, curve: 0.6)), attach: Mouth),
                        ],
                    ),
                ],
            ),
            (
                name: "wing",
                kind: Wing((
                    kind: Feathered((primaries: 10, secondaries: 12, covert_rows: 2, shape: Slotted)),
                    span: 0.95,
                    chord: 0.32,
                    fold: 1.0,
                    sweep_deg: 6.0,
                    radius: 0.035,
                )),
                attach: Surface(t: 0.8, around_deg: 70.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Femur hidden in the body, tibiotarsus back-sloping, long tarsometatarsus.
                name: "leg",
                kind: Limb((
                    chain: (segments: 3, length: 0.46, ratios: [0.7, 1.2, 0.9], radius: (curve: [(0.0, 1.3), (0.3, 0.9), (0.6, 0.5), (1.0, 0.45)], scale: 0.028)),
                    role: Locomotor,
                    stance: Digitigrade,
                    end: Pad,
                    joints: Some((plan: Hindleg, swing: 40.0, flex: [85.0, 55.0])),
                )),
                attach: Surface(t: 0.38, around_deg: 125.0),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "talons",
                        kind: Digits((count: 3, chain: (segments: 2, length: 0.07, radius: (scale: 0.009), curl: 250.0), spread_deg: 60.0, tip: Some((kind: Claw, size: 0.025)))),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
            (
                name: "tail",
                kind: Chain((role: Tail, chain: (segments: 2, length: 0.16, radius: (curve: [(0.0, 1.0), (1.0, 0.8)], scale: 0.04, cross: Flat(aspect: 3.0))))),
                attach: Start,
            ),
        ],
    ),
    tone: (muscle: 0.5, fat: 0.2),
)
