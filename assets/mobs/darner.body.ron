                kind: Wing((kind: Blade((planform: Long)), span: 0.48, chord: 0.125, fold: 0.0, sweep_deg: 10.0)),
                attach: Surface(t: 0.32, around_deg: 25.0),
                mirror: true,
                detail: Always,
            ),
            (
                name: "leg.fore",
                kind: Limb((chain: (segments: 3, length: 0.11, ratios: [1.0, 1.1, 0.6], segmented: 0.6, radius: (curve: [(0.0, 1.0), (1.0, 0.5)], scale: 0.0055)), role: Locomotor, stance: Arched, end: Point, joints: Some((plan: Arched, swing: 0.0, lift: 20.0, flex: [110.0, 30.0])))),
                attach: Surface(t: 0.85, around_deg: 160.0),
