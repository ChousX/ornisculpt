// A six-legged insect on cockroach/beetle proportions (body ~0.6 m; see
// docs/design/anatomy-reference.md). Three tagmata: head, thorax and a legless abdomen. All six
// legs attach to the thorax, one pair per thoracic segment; fore legs reach forward, mid legs
// out, hind legs (the longest) back. Femur raised, tibia down to the ground, tarsus along it.
(
    root: (
        // Thorax ≈ 0.3 of body length: pro-, meso- and metathorax.
        name: "thorax",
        kind: Torso((
            chain: (segments: 3, length: 0.17, radius: (curve: [(0.0, 0.9), (0.6, 1.0), (1.0, 0.8)], scale: 0.065, cross: Ellipse(aspect: 1.4))),
        )),
        detail: Always,
        children: [
            (
                // ≈ 0.15 of body length.
                name: "head",
                kind: Head((skull: (shape: Ellipsoid, size: (0.05, 0.04, 0.045)), snout: 0.01, jaw: None, eye_spacing: 0.9, eye_lateral: 0.9)),
                attach: End,
                offset: (rotate_deg: (20.0, 0.0, 0.0)),
                detail: Always,
                children: [
                    (name: "eye", kind: Hard((kind: Eye, size: 0.02)), attach: Eye, mirror: true),
                    (name: "antenna", kind: Chain((role: Antenna, chain: (segments: 3, length: 0.3, radius: (curve: [(0.0, 1.0), (1.0, 0.4)], scale: 0.006), curl: 90.0, blend: 0.004))), attach: Horn, mirror: true),
                ],
            ),
            (
                // ≈ 0.55 of body length, legless, wider and flatter than the thorax; spring motion
                // gives it a slight sway.
                name: "abdomen",
                kind: Chain((role: Tail, chain: (segments: 3, length: 0.32, radius: (curve: [(0.0, 0.85), (0.35, 1.0), (1.0, 0.35)], scale: 0.085, cross: Ellipse(aspect: 1.5)), curl: -15.0, blend: 0.03))),
                attach: Start,
                detail: Always,
                children: [
                    (
                        name: "plate",
                        kind: Hard((kind: Plate, size: 0.1, curve: 0.6)),
                        attach: Surface(t: 0.5, around_deg: 0.0),
                        repeat: Series(count: 3, from: 0.15, to: 0.7),
                    ),
                ],
            ),
            (
                // Prothoracic legs: shortest, reaching forward.
                name: "leg.fore",
                kind: Limb((chain: (segments: 3, length: 0.3, ratios: [1.0, 1.15, 0.75], radius: (curve: [(0.0, 1.0), (0.45, 0.6), (1.0, 0.35)], scale: 0.022)), role: Locomotor, stance: Arched, end: Point, bends: [(0.0, 45.0), (0.0, -115.0), (0.0, -30.0)])),
                attach: Surface(t: 0.85, around_deg: 95.0),
                offset: (rotate_deg: (40.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                // Mesothoracic legs: out to the side.
                name: "leg.mid",
                kind: Limb((chain: (segments: 3, length: 0.36, ratios: [1.0, 1.15, 0.75], radius: (curve: [(0.0, 1.0), (0.45, 0.6), (1.0, 0.35)], scale: 0.024)), role: Locomotor, stance: Arched, end: Point, bends: [(0.0, 45.0), (0.0, -115.0), (0.0, -30.0)])),
                attach: Surface(t: 0.5, around_deg: 95.0),
                mirror: true,
                detail: Always,
            ),
            (
                // Metathoracic legs: longest, sweeping back.
                name: "leg.hind",
                kind: Limb((chain: (segments: 3, length: 0.44, ratios: [1.0, 1.15, 0.75], radius: (curve: [(0.0, 1.0), (0.45, 0.6), (1.0, 0.35)], scale: 0.026)), role: Locomotor, stance: Arched, end: Point, bends: [(0.0, 45.0), (0.0, -115.0), (0.0, -30.0)])),
                attach: Surface(t: 0.15, around_deg: 95.0),
                offset: (rotate_deg: (-40.0, 0.0, 0.0)),
                mirror: true,
                detail: Always,
            ),
        ],
    ),
    tone: (muscle: 0.2, fat: 0.1, landmarks: 0.6),
)
