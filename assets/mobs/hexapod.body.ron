// A six-legged crawler: three mirrored leg pairs spaced along the body with `Series`.
(
    root: (
        name: "torso",
        kind: Torso((
            chain: (segments: 4, length: 0.6, radius: (curve: [(0.0, 0.7), (0.4, 1.0), (1.0, 0.8)], scale: 0.1, cross: Ellipse(aspect: 1.6))),
        )),
        detail: Always,
        children: [
            (
                name: "head",
                kind: Head((skull: (shape: Ellipsoid, size: (0.07, 0.05, 0.07)), snout: 0.02, jaw: None, eye_spacing: 0.8, eye_lateral: 0.7)),
                attach: End,
                detail: Always,
                children: [
                    (name: "eye", kind: Hard((kind: Eye, size: 0.022)), attach: Eye, mirror: true),
                    (name: "antenna", kind: Chain((role: Antenna, chain: (segments: 4, length: 0.22, radius: (curve: [(0.0, 1.0), (1.0, 0.4)], scale: 0.008), curl: 120.0, blend: 0.005))), attach: Horn, mirror: true),
                ],
            ),
            (
                name: "plate",
                kind: Hard((kind: Plate, size: 0.11, curve: 0.6)),
                attach: Surface(t: 0.5, around_deg: 0.0),
                repeat: Series(count: 4, from: 0.2, to: 0.85),
            ),
            (
                name: "leg",
                kind: Limb((chain: (segments: 3, length: 0.42, radius: (curve: [(0.0, 1.0), (1.0, 0.35)], scale: 0.03)), role: Locomotor, stance: Sprawl, end: Point)),
                attach: Surface(t: 0.5, around_deg: 105.0),
                repeat: Series(count: 3, from: 0.2, to: 0.8),
                mirror: true,
                detail: Always,
            ),
        ],
    ),
    tone: (muscle: 0.2, fat: 0.1, landmarks: 0.6),
)
