// An orc (fantasy): a brutish, heavily muscled humanoid ~1.95 m, built on human segment ratios
// pushed toward a strongman's: very broad shoulders and a barrel chest, a thick neck sloping into
// massive trapezii, arms and thighs heavy with muscle, big hands. The head is human in plan but
// coarse: a jutting brow ridge, a broad flat nose, heavy cheekbones and a wide, square jaw with
// tusks rising from it; pointed ears swept back. Carried slightly stooped, knees soft.
//
// The torso stands vertically (t = 0 pelvis, 1 shoulders; around 0 = back, 90 = left, 180 = front).
(
    root: (
        name: "torso",
        kind: Torso((
            // Pelvis → waist → ribcage → shoulders: the V of a man's trunk, widest over the
            // shoulders, ~1.5× wider than deep.
            chain: (segments: 3, length: 0.6, radius: (curve: [(0.0, 0.95), (0.18, 0.94), (0.38, 0.9), (0.62, 1.02), (0.82, 1.1), (0.92, 1.06), (1.0, 0.62)], scale: 0.168, cross: Ellipse(aspect: 1.5))),
            belly: 0.25,
        )),
        offset: (rotate_deg: (-82.0, 0.0, 0.0)),
        detail: Always,
        stamps: Custom([
            (at: Surface(t: 0.8, around_deg: 152.0), kind: Muscle, size: (0.72, 0.5, 0.4), depth: 0.08, mirror: true),  // pectorals
            (at: Surface(t: 0.93, around_deg: 100.0), kind: Muscle, size: (0.34, 0.32, 0.3), depth: 0.06, mirror: true), // top of the shoulder
            (at: Surface(t: 0.98, around_deg: 30.0), kind: Muscle, size: (0.65, 0.5, 0.45), depth: 0.16, mirror: true),   // trapezius
            (at: Surface(t: 0.8, around_deg: 35.0), kind: Landmark, size: (0.28, 0.4, 0.15), depth: 0.03, mirror: true), // shoulder blade
            (at: Surface(t: 0.62, around_deg: 70.0), kind: Muscle, size: (0.45, 0.7, 0.3), depth: 0.04, mirror: true),  // lats
            (at: Surface(t: 0.5, around_deg: 15.0), kind: Muscle, size: (0.16, 1.6, 0.2), depth: 0.05, mirror: true),   // ridges either side of the spine
            (at: Surface(t: 0.45, around_deg: 170.0), kind: Muscle, size: (0.24, 0.95, 0.22), depth: 0.01, mirror: true), // rectus abdominis
            (at: Surface(t: 0.6, around_deg: 130.0), kind: Landmark, size: (0.5, 0.3, 0.15), depth: 0.02, mirror: true), // lower ribs
            (at: Surface(t: 0.12, around_deg: 30.0), kind: Muscle, size: (0.6, 0.6, 0.48), depth: 0.08, mirror: true),  // buttock
            (at: Surface(t: 0.2, around_deg: 115.0), kind: Landmark, size: (0.3, 0.25, 0.15), depth: 0.025, mirror: true), // hip bone (iliac crest)
            (at: Surface(t: 0.38, around_deg: 180.0), kind: Fat, size: (0.55, 0.6, 0.4), depth: 0.03, mirror: false),  // belly
        ]),
        children: [
            (
                name: "neck",
                kind: Chain((role: Neck, chain: (segments: 2, length: 0.09, radius: (curve: [(0.0, 1.35), (0.4, 1.05), (1.0, 0.95)], scale: 0.075, cross: Ellipse(aspect: 1.1))))),
                attach: End,
                offset: (rotate_deg: (22.0, 0.0, 0.0)),
                detail: Always,
                stamps: Custom([
                    (at: Surface(t: 0.5, around_deg: 150.0), kind: Muscle, size: (0.25, 1.3, 0.25), depth: 0.05, mirror: true), // sternocleidomastoid
                    (at: Surface(t: 0.55, around_deg: 180.0), kind: Landmark, size: (0.25, 0.25, 0.2), depth: 0.05, mirror: false), // Adam's apple
                ]),
                children: [
                    (
                        name: "head",
                        kind: Head((
                            skull: (shape: Ellipsoid, size: (0.088, 0.112, 0.105)),
                            snout: 0.0,
                            jaw: Some((segments: 1, length: 0.1)),
                            eye_spacing: 0.46,
                            face: Some((nose: 1.05, brow: 2.0, cheekbones: 1.4, lips: 1.2, chin: 1.35, jaw_width: 1.5, cheeks: 1.1)),
                        )),
                        offset: (rotate_deg: (-18.0, 0.0, 0.0)),
                        detail: Always,
                        children: [
                            (name: "eye", kind: Hard((kind: Eye, size: 0.011, sclera: 0.5)), attach: Eye, mirror: true),
                            // Pointed ears, swept back.
                            (name: "ear", kind: Chain((role: Ear, chain: (segments: 2, length: 0.085, radius: (curve: [(0.0, 1.0), (0.4, 0.9), (1.0, 0.12)], scale: 0.022, cross: Flat(aspect: 2.6)), blend: 0.006))), attach: Ear, offset: (rotate_deg: (-70.0, 0.0, 15.0)), mirror: true),
                            // Tusks from the lower jaw, up past the upper lip.
                            (name: "tusk", kind: Hard((kind: Tusk, size: 0.042, curve: 0.25)), attach: Mouth, offset: (translate: (0.026, -0.012, 0.02), rotate_deg: (-75.0, 0.0, 10.0)), mirror: true),
                        ],
                    ),
                ],
            ),
            (
                name: "leg",
                kind: Limb((
                    chain: (segments: 2, length: 0.92, ratios: [1.0, 0.95], radius: (curve: [(0.0, 1.2), (0.22, 1.08), (0.45, 0.74), (0.56, 0.76), (0.68, 0.78), (1.0, 0.44)], scale: 0.11)),
                    role: Locomotor,
                    stance: Plantigrade,
                    end: Foot(length: 0.3),
                    joints: Some((plan: Leg, swing: 14.0, flex: [22.0])),
                )),
                attach: Surface(t: 0.05, around_deg: 116.0),
                offset: (translate: (0.0, -0.04, 0.0)),
                mirror: true,
                detail: Always,
            ),
            (
                name: "arm",
                kind: Limb((
                    chain: (segments: 2, length: 0.7, ratios: [1.0, 0.82], radius: (curve: [(0.0, 1.3), (0.22, 1.1), (0.5, 0.8), (0.62, 0.95), (1.0, 0.6)], scale: 0.07)),
                    role: Manipulator,
                    end: Hand(palm: 0.13),
                    joints: Some((plan: Arm, swing: 8.0, flex: [22.0])),
                    splay_deg: 12.0,
                )),
                attach: Surface(t: 0.9, around_deg: 92.0),
                // Turned so the palms face the thighs.
                offset: (translate: (0.0, 0.035, 0.0), rotate_deg: (0.0, 75.0, 0.0)),
                mirror: true,
                detail: Always,
                children: [
                    (
                        name: "fingers",
                        kind: Digits((count: 5, chain: (segments: 3, length: 0.115, ratios: [1.0, 0.66, 0.55], radius: (curve: [(0.0, 1.0), (1.0, 0.85)], scale: 0.0135), curl: 480.0), spread_deg: 5.0, opposable: true, tip: Some((kind: Claw, size: 0.016, curve: 0.3)))),
                        attach: End,
                        detail: UpTo(Hero),
                    ),
                ],
            ),
        ],
    ),
    tone: (muscle: 1.35, fat: 0.3, landmarks: 0.5),
)
