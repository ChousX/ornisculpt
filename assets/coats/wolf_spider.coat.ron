// A wolf spider: grey-brown and hairy, a pale stripe down the middle of the prosoma between two
// dark bands, a dark heart mark on the abdomen, banded legs, glossy black eyes and fangs.
(
    base: (0.36, 0.28, 0.19),
    secondary: (0.2, 0.15, 0.1),
    accent: (0.62, 0.52, 0.38),
    roughness: 0.8,
    hard: (0.04, 0.03, 0.025),
    iris: (0.01, 0.01, 0.012),
    coverings: [
        (regions: AllExcept([Kind(Hard)]), kind: Fur((length: 0.006, density: 1400.0, thickness: 0.6, tip: 0.5, shells: 8))),
