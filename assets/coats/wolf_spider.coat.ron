        (color: (0.13, 0.1, 0.07), regions: Or([Kind(TorsoFront), Kind(TorsoMid), Kind(TorsoRear), Kind(Skull)]), facing: Some((dir: (0.0, 1.0, 0.0), from: 0.3, to: 0.6))),
