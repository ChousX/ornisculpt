        (color: (0.6, 0.5, 0.36), regions: Or([Kind(TorsoFront), Kind(TorsoMid), Kind(TorsoRear), Kind(Skull)]), facing: Some((dir: (0.0, 1.0, 0.0), from: 0.93, to: 0.985))),
