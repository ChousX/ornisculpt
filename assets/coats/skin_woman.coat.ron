// Light olive human skin with rosy lips and cheeks; auburn hair; hazel eyes.
(
    base: (0.8, 0.6, 0.49),
    secondary: (0.64, 0.44, 0.36),
    accent: (0.88, 0.7, 0.6),
    roughness: 0.5,
    hard: (0.88, 0.72, 0.68),
    iris: (0.3, 0.24, 0.1),
    coverings: [
        // Hair: fine, dense strands over the sculpted cap and ponytail.
        (regions: Or([Part("torso/neck/head/hair"), Part("torso/neck/head/fall")]), kind: Fur((length: 0.03, density: 2400.0, thickness: 0.95, tip: 0.1, shells: 10, cards: Some((length: 0.22, width: 0.022, density: 3200.0, lift_deg: 5.0, droop: 0.9))))),
        // ... and over the top and back of the skull itself, to the hairline.
        (regions: Kind(Skull), facing: Some((dir: (0.0, 0.72, -0.7), from: -0.05, to: 0.2)), kind: Fur((length: 0.03, cards: Some((length: 0.22, width: 0.022, density: 3200.0, lift_deg: 5.0, droop: 0.9))))),
        // Eyebrows on the front of the brow ridges; lashes on the lid rims.
        (regions: Kind(Brow), facing: Some((dir: (0.0, -0.3, 1.0), from: 0.45, to: 0.75)), kind: Fur((length: 0.006))),
        (regions: Kind(Eyelid), facing: Some((dir: (0.0, 0.0, 1.0), from: 0.55, to: 0.85)), kind: Fur((length: 0.008))),
    ],
    markings: [
        (color: (0.78, 0.54, 0.46), regions: Or([Kind(LimbEnd), Kind(Digit)]), strength: 0.6),
        // A little colour in the cheeks.
        (color: (0.82, 0.52, 0.46), regions: Kind(Face), patches: Some((size: 0.03, cover: 0.5, soft: 0.3, seed: 2)), strength: 0.25),
        // Lips.
        (color: (0.64, 0.32, 0.3), regions: Kind(Lip), facing: Some((dir: (0.0, 0.0, 1.0), from: 0.5, to: 0.8)), strength: 0.6),
        // Auburn hair over the crown, back of the head and the ponytail.
        // Lids a little darker and warmer; brows and lashes the hair's auburn, lashes darker.
        (color: (0.7, 0.44, 0.4), regions: Kind(Eyelid), strength: 0.5),
        (color: (0.42, 0.2, 0.08), regions: Kind(Brow), facing: Some((dir: (0.0, -0.3, 1.0), from: 0.45, to: 0.75))),
        (color: (0.14, 0.07, 0.04), regions: Kind(Eyelid), facing: Some((dir: (0.0, 0.0, 1.0), from: 0.55, to: 0.85)), strength: 0.85),
        (color: (0.42, 0.2, 0.08), regions: Or([Part("torso/neck/head/hair"), Part("torso/neck/head/fall")])),
        (color: (0.42, 0.2, 0.08), regions: Kind(Skull), facing: Some((dir: (0.0, 0.72, -0.7), from: -0.05, to: 0.2))),
    ],
)
