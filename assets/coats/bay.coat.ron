// A bay horse: red-brown body, black points (lower legs, mane, tail), a dark muzzle and black
// hooves; short, sleek summer coat.
(
    base: (0.42, 0.2, 0.09),
    secondary: (0.26, 0.12, 0.05),
    accent: (0.55, 0.32, 0.16),
    roughness: 0.6,
    hard: (0.12, 0.11, 0.1),
    coverings: [
        (
            regions: AllExcept([Kind(LimbEnd), Kind(Snout), Kind(Hard), Kind(Mass), Kind(TailBase), Kind(TailTip)]),
            kind: Fur((length: 0.008, density: 900.0, thickness: 0.8, tip: 0.2, shells: 8)),
        ),
        // Mane, forelock and tail: long hair (its own length; the rest as the body coat).
        (regions: Or([Part("torso/neck/mane"), Part("torso/neck/head/forelock")]), kind: Fur((length: 0.035))),
        (regions: Or([Kind(TailBase), Kind(TailTip)]), kind: Fur((length: 0.045))),
    ],
    markings: [
        // Black points: the legs darken from the knee and hock down.
        (color: (0.05, 0.04, 0.035), regions: Role(Locomotor), along: Some((0.45, 0.62))),
        // Hooves: dark horn.
        (color: (0.09, 0.085, 0.08), regions: Kind(LimbEnd)),
        // Muzzle: dark grey skin round the nostrils and lips.
        (color: (0.13, 0.1, 0.09), regions: Or([Kind(Snout), Kind(Jaw)]), tip: Some((0.72, 0.9))),
        // Mane and forelock black.
        (color: (0.04, 0.035, 0.03), regions: Or([Part("torso/neck/mane"), Part("torso/neck/head/forelock")])),
        // Lighter flank and belly, faintly.
        (color: (0.55, 0.3, 0.15), regions: Or([Kind(Belly), Kind(TorsoMid)]), facing: Some((dir: (0.0, -1.0, 0.0), from: 0.2, to: 0.9)), strength: 0.5),
        (color: (0.05, 0.04, 0.035), regions: Kind(TailBase)),
        (color: (0.05, 0.04, 0.035), regions: Kind(TailTip)),
    ],
)
