// A male green darner: a bright green thorax and face, a blue abdomen with a dark dorsal stripe
// and black rings at the joints, brown-green eyes; clear wings with an amber tint and a tan
// pterostigma. Glossy cuticle.
(
    base: (0.3, 0.62, 0.22),
    secondary: (0.08, 0.08, 0.06),
    accent: (0.78, 0.66, 0.36),
    roughness: 0.3,
    hard: (0.05, 0.05, 0.04),
    iris: (0.35, 0.4, 0.2),
    markings: [
        // Blue abdomen, purplish at the base.
        (color: (0.2, 0.42, 0.78), regions: Or([Kind(TailBase), Kind(TailTip)])),
        (color: (0.38, 0.32, 0.6), regions: Kind(TailBase), along: Some((0.12, 0.0))),
        // Dark dorsal stripe down the abdomen.
        (color: (0.07, 0.08, 0.1), regions: Or([Kind(TailBase), Kind(TailTip)]), facing: Some((dir: (0.0, 1.0, 0.0), from: 0.6, to: 0.82))),
        // Black rings at the segment joints.
        (color: (0.05, 0.05, 0.06), regions: Or([Kind(TailBase), Kind(TailTip)]), bands: Some((count: 8.0, width: 0.26, soft: 0.12, offset: 0.5))),
        // Dark legs.
        (color: (0.08, 0.07, 0.06), regions: Role(Locomotor)),
        // Tan sides of the thorax under the wings.
        (color: (0.42, 0.55, 0.22), regions: Or([Kind(TorsoFront), Kind(TorsoMid), Kind(TorsoRear)]), facing: Some((dir: (0.0, -1.0, 0.0), from: 0.0, to: 0.7))),
    ],
)
